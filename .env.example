# ============================================================
# Burp Sentinel - LLM provider config
# ============================================================
# To get REAL AI answers: paste your API key below and leave
# SENTINEL_PROVIDER=openai_compatible. That's the only thing
# you need to change for the DeepSeek example.
#
# No key yet? You can switch SENTINEL_PROVIDER=mock to test the
# pipeline offline (chat returns fake, deterministic answers).
# ============================================================

SENTINEL_PROVIDER=openai_compatible

# Your provider endpoint + model (DeepSeek example — any OpenAI-compatible
# provider works, e.g. OpenRouter: https://openrouter.ai/api/v1).
SENTINEL_BASE_URL=https://api.deepseek.com/
SENTINEL_MODEL=deepseek-v4-flash

# >>> PASTE YOUR API KEY HERE <<<
# Create one at your provider, e.g. DeepSeek: https://platform.deepseek.com -> API Keys
# (OpenRouter: https://openrouter.ai/keys)
SENTINEL_API_KEY=

# Internal paths — usually leave as-is.
SENTINEL_WSTG_CHECKLIST_PATH=sentinel_api/data/wstg_checklist.json
SENTINEL_SKILLS_DIR=sentinel_api/skills
