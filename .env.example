# LLM provider config.
# mock = local deterministic summaries (no external login)
# openai_compatible = call any OpenAI-compatible LLM API directly (DeepSeek, OpenRouter, ...)
SENTINEL_PROVIDER=mock
# For openai_compatible:
SENTINEL_BASE_URL=https://api.deepseek.com/
SENTINEL_MODEL=deepseek-v4-flash
SENTINEL_API_KEY=optional
SENTINEL_WSTG_CHECKLIST_PATH=sentinel_api/data/wstg_checklist.json
SENTINEL_SKILLS_DIR=sentinel_api/skills
